{
  "manifest_version": 3,
  "name": "Chatcap — YouTube Chat Capture",
  "short_name": "Chatcap",
  "version": "0.2.3",
  "description": "Capture YouTube live chat and comments in real time, save them as JSON, and analyze/export them — right from your browser.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "tabs",
    "downloads",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_origin",
        "enabled": true,
        "path": "rules/youtube-origin.json"
      }
    ]
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Chatcap side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/youtube.js"],
      "run_at": "document_idle"
    }
  ]
}
